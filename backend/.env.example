# Copy this file to backend/.env and fill in real values.
# backend/.env is gitignored and must NEVER be committed.

# --- PostgreSQL ---
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=crypto-wallet

# Or full URL (encode special chars in password, e.g. @ → %40):
# DATABASE_URL=postgresql+psycopg2://postgres:change-me@127.0.0.1:5432/crypto-wallet

# --- App secrets (generate long random strings) ---
# Example: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=generate-a-long-random-string
JWT_SECRET=generate-another-long-random-string
JWT_EXPIRE_MINUTES=10080

# --- Optional admin bootstrap ---
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=change-me-strong-password

# --- Optional Ethereum RPC ---
# ETH_RPC_URL=https://eth.llamarpc.com

# --- CORS (comma-separated frontend origins; no wildcards) ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Minimum password length for new accounts / password changes
PASSWORD_MIN_LENGTH=8
